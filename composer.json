{
    "name": "allnewsapi/allnewsapi",
    "description": "PHP SDK for AllNewsAPI - a news aggregation REST API",
    "type": "library",
    "version": "0.1.0",
    "keywords": ["allnewsapi", "news", "api", "sdk", "php"],
    "license": "MIT",
    "authors": [
        {
            "name": "AllNewsAPI",
            "email": "developers@allnewsapi.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AllNewsAPI\\": "php-sdk/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AllNewsAPI\\Tests\\": "php-sdk/tests/"
        }
    }
}
