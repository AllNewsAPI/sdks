{
    "name": "allnewsapi/allnewsapi",
    "description": "PHP SDK for AllNewsAPI",
    "type": "library",
    "version": "0.2.1",
    "keywords": [
        "allnewsapi",
        "news",
        "api",
        "sdk"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "AllNewsAPI",
            "email": "contact@allnewsapi.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AllNewsAPI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AllNewsAPI\\Tests\\": "tests/"
        }
    }
}
